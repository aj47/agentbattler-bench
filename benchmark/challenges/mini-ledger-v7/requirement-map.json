    { "id": "V7-P2-PRIVATE-PAGINATION", "clauseIds": ["P2-C2", "P2-C3", "P2-C4"], "privateClassWeights": { "atomic": 3, "composed": 5 }, "verifierAssertionIds": ["p2.atomic.cursor-filter-tamper-binding", "p2.composed.cursor-boundary-lineage-evolution"] },
    { "id": "V7-P3-PUBLIC-SERIALIZE", "clauseIds": ["P3-C1", "P3-C2"], "verifierAssertionIds": ["p3.public.concurrent-append-bounded-compaction"] },
    { "id": "V7-P3-PRIVATE-ATOMICITY", "clauseIds": ["P3-C1", "P3-C2"], "privateClassWeights": { "atomic": 6, "composed": 10 }, "verifierAssertionIds": ["p3.atomic.lifecycle-linearization", "p3.composed.multiwriter-reader-serializability"] },
    { "id": "V7-P3-PRIVATE-TERMINATION", "clauseIds": ["P3-C3", "P3-C4"], "privateClassWeights": { "atomic": 3, "composed": 5 }, "verifierAssertionIds": ["p3.atomic.stable-storage-ordering", "p3.composed.seeded-prior-or-next-recovery"] },
    { "id": "V7-P4-PUBLIC-INCIDENT", "clauseIds": ["P4-C1", "P4-C2"], "verifierAssertionIds": ["p4.public.canonical-incident-classification"] },
    { "id": "V7-P4-PRIVATE-PROVENANCE", "clauseIds": ["P4-C1", "P4-C2"], "privateClassWeights": { "atomic": 2, "composed": 2 }, "verifierAssertionIds": ["p4.atomic.canonical-lineage-citation", "p4.composed.complete-deployment-provenance"] },
    { "id": "V7-P4-PRIVATE-SOURCE", "clauseIds": ["P4-C3"], "privateClassWeights": { "atomic": 1, "composed": 3 }, "verifierAssertionIds": ["p4.atomic.executable-tree-identity", "p4.composed.response-source-commitment"] },
    { "id": "V7-P5-PUBLIC-RECOVER", "clauseIds": ["P5-C1", "P5-C4"], "verifierAssertionIds": ["p5.public.corrupt-primary-valid-lineage-recovery"] },
    { "id": "V7-P5-PRIVATE-LINEAGE", "clauseIds": ["P5-C1", "P5-C4"], "privateClassWeights": { "atomic": 3, "composed": 5 }, "verifierAssertionIds": ["p5.atomic.fork-rollback-rejection", "p5.composed.candidate-conflict-reconciliation"] },
    { "id": "V7-P5-PRIVATE-REPLAY", "clauseIds": ["P5-C2", "P5-C4"], "privateClassWeights": { "atomic": 1, "composed": 3 }, "verifierAssertionIds": ["p5.atomic.exact-replay-audit", "p5.composed.corruption-detection-nonmutation"] },
    { "id": "V7-P5-PRIVATE-SCALE", "clauseIds": ["P5-C2", "P5-C3", "P5-C4"], "privateClassWeights": { "atomic": 2, "composed": 2 }, "verifierAssertionIds": ["p5.atomic.mixed-interface-scale", "p5.composed.compact-import-recover-scale"] }
  ]
}
