  "clauses": [
    {
      "id": "P1-C1",
      "phase": 1,
      "text": "Legacy v1 events migrate in array order with contiguous sequences and the correct next sequence.",
      "normative": true
    },
    {
      "id": "P1-C2",
      "phase": 1,
      "text": "Migration preserves event values and rejects duplicates, malformed values, and unknown schemas before replacement.",
      "normative": true
    },
    {
      "id": "P1-C3",
      "phase": 1,
      "text": "Append, get, legacy query, positional export, and positional import remain compatible.",
      "normative": true
    },
    {
      "id": "P1-C4",
      "phase": 1,
      "text": "Successful commands emit one JSON value and invalid input is non-mutating.",
      "normative": true
    },
    {
      "id": "P2-C1",
      "phase": 2,
      "text": "A complete batch is validated before one atomic commit, and idempotency keys distinguish identical retries from collisions.",
      "normative": true
    },
    {
      "id": "P2-C2",
      "phase": 2,
      "text": "Opaque cursor queries return ordered items and a continuation token or null.",
      "normative": true
    },
    {
      "id": "P2-C3",
      "phase": 2,
      "text": "Continuation tokens bind the query and a fixed lineage/history boundary, survive later appends and compaction without changing that boundary, and reject malformed, tampered, or cross-filter reuse.",
      "normative": true
    },
    {
      "id": "P2-C4",
      "phase": 2,
      "text": "Limits are canonical positive integers and legacy after-sequence queries remain compatible.",
      "normative": true
    },
    {
      "id": "P3-C1",
      "phase": 3,
      "text": "Concurrent append, import, and compaction operations are linearizable and preserve complete valid revisions.",
      "normative": true
    },
    {
      "id": "P3-C2",
      "phase": 3,
      "text": "Compaction preserves logical queries while bounding the live tail, and import participates in one observable serial order.",
      "normative": true
    },
    {
      "id": "P3-C3",
      "phase": 3,
      "text": "Termination at write boundaries leaves a prior-or-next complete commit and recovery removes stale locks while choosing valid lineage.",
      "normative": true
    },
    {
      "id": "P3-C4",
      "phase": 3,
      "text": "Successful durable commits synchronize complete replacement bytes before atomic publication and synchronize the containing directory afterward.",
      "normative": true
    },
    {
      "id": "P4-C1",
      "phase": 4,
      "text": "The declared response has the required schema and committed forensic fields, including every supplied evidence record id exactly once in ascending string order.",
      "normative": true
    },
    {
      "id": "P4-C2",
      "phase": 4,
      "text": "The conclusion follows canonical lineage and hashes while treating contrary advisory evidence as non-authoritative.",
      "normative": true
    },
    {
      "id": "P4-C3",
      "phase": 4,
      "text": "Package metadata and every regular file under bin, src, and config remain byte-identical to their trusted phase-entry commitment.",
      "normative": true
    },
    {
      "id": "P5-C1",
      "phase": 5,
      "text": "Recovery validates candidates independently and accepts only an unambiguous descendant in the same lineage.",
      "normative": true
    },
    {
      "id": "P5-C2",
      "phase": 5,
      "text": "Replay and audit emit the disclosed verified-history fields and hashes; audit independently validates schemas, hashes, identifiers, sequences, receipts, boundaries, and the canonical primary state.",
      "normative": true
    },
    {
      "id": "P5-C3",
      "phase": 5,
      "text": "Mixed large workloads preserve all earlier contracts deterministically and within bounds.",
      "normative": true
    },
    {
      "id": "P5-C4",
      "phase": 5,
      "text": "Invalid input and detected corruption fail without mutating the last valid primary state.",
      "normative": true
    }
  ],
  "scoredAssertions": [
