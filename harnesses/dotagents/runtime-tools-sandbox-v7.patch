+const AGENTBATTLER_CAPABILITY_GUARD = 'cap="$(sed -n "s/^CapEff:[[:space:]]*//p" /proc/self/status)"; case "$cap" in ""|*[!0]*) echo "AgentBattler V7 command sandbox retained capabilities" >&2; exit 77;; esac; exec /bin/bash -lc "$1"'
+
+function agentBattlerSandboxArguments(command: string, cwd: string): string[] {
+  const resolvedCwd = path.resolve(cwd)
+  if (resolvedCwd !== AGENTBATTLER_WORKSPACE && !resolvedCwd.startsWith(`${AGENTBATTLER_WORKSPACE}${path.sep}`)) {
+    throw new Error("AgentBattler command working directory is outside /workspace")
+  }
+  const readOnlyControlRoot = process.env.AGENTBATTLER_V7_CONTROL_ROOT
+  if (readOnlyControlRoot !== `${AGENTBATTLER_WORKSPACE}/.agentbattler`) {
+    throw new Error("AgentBattler V7 control root is invalid")
+  }
+  return [
+    "--die-with-parent",
+    "--new-session",
+    "--unshare-pid",
+    "--unshare-net",
+    "--unshare-ipc",
+    "--unshare-uts",
+    "--cap-drop", "ALL",
+    "--tmpfs", "/",
+    "--proc", "/proc",
+    "--ro-bind", "/usr", "/usr",
+    "--dir", "/etc",
+    "--ro-bind", "/etc/passwd", "/etc/passwd",
+    "--ro-bind", "/etc/group", "/etc/group",
+    "--symlink", "usr/bin", "/bin",
+    "--symlink", "usr/lib", "/lib",
+    "--symlink", "usr/lib64", "/lib64",
+    "--dir", AGENTBATTLER_WORKSPACE,
+    "--bind", AGENTBATTLER_WORKSPACE, AGENTBATTLER_WORKSPACE,
+    "--ro-bind", readOnlyControlRoot, readOnlyControlRoot,
+    "--tmpfs", "/tmp",
+    "--dev", "/dev",
+    "--clearenv",
+    "--setenv", "PATH", AGENTBATTLER_COMMAND_ENV.PATH!,
+    "--setenv", "HOME", AGENTBATTLER_COMMAND_ENV.HOME!,
+    "--setenv", "LANG", AGENTBATTLER_COMMAND_ENV.LANG!,
+    "--setenv", "LC_ALL", AGENTBATTLER_COMMAND_ENV.LC_ALL!,
+    "--setenv", "TZ", AGENTBATTLER_COMMAND_ENV.TZ!,
+    "--setenv", "TMPDIR", AGENTBATTLER_COMMAND_ENV.TMPDIR!,
+    "--chdir", resolvedCwd,
+    "--", "/bin/bash", "-c", AGENTBATTLER_CAPABILITY_GUARD, "agentbattler-v7-capability-guard", command,
+  ]
+}
